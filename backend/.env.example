# Copia este archivo a .env. Nunca subas .env al repositorio.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://notebooklm:notebooklm@localhost:5432/notebooklm
CORS_ORIGINS=http://localhost:5173
SECRET_KEY=change-me-in-production
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25

# Proveedor de IA: "mock" (datos de demostración) hasta integrar uno real.
AI_PROVIDER=mock
# AI_API_KEY=   (solo backend; nunca en el frontend)
# La dimensión debe coincidir con el modelo de embeddings elegido.
EMBEDDING_DIMENSIONS=768
